# =============================================================================
# FinanceFlow — Exemplo de Variáveis de Ambiente (.env.example)
#
# Copie para .env.local (front-end) ou .env (back-end) e preencha.
# NUNCA faça commit de arquivos .env ou .env.local com chaves reais.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONT-END (Vite) — Expostas ao navegador (SOMENTE chave pública anon/publishable)
#    PROIBIDO colocar service_role ou sb_secret_ com prefixo VITE_ ou NEXT_PUBLIC_
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<sua-chave-publica-anon-ou-publishable>

# -----------------------------------------------------------------------------
# 2. BACK-END / SERVIDOR / EDGE FUNCTIONS — Lidas apenas via process.env no servidor
#    JAMAIS exponha estas variáveis no front-end
# -----------------------------------------------------------------------------
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<sua-chave-secreta-service-role-apenas-no-servidor>
DATABASE_URL=postgresql://postgres.<seu-projeto>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
ALLOWED_ORIGIN=http://localhost:5173
