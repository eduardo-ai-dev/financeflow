# Copie para .env.local e preencha (Supabase → Project Settings → API).
# .env.local é ignorado pelo git; NUNCA commite chaves reais.
# Use somente a chave pública (anon / publishable) — jamais a service_role.
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<sua-chave-anon-ou-publishable>

